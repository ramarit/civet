{
  "name": "@civet/translation-engine",
  "version": "1.0.0",
  "description": "Robust AI translation engine with multi-provider support, caching, and quality scoring",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "clean": "rm -rf dist",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "keywords": [
    "translation",
    "ai",
    "anthropic",
    "openai",
    "deepl",
    "claude",
    "gpt-4",
    "multilingual",
    "i18n",
    "localization"
  ],
  "author": "Civet AI Team",
  "license": "MIT",
  "dependencies": {
    "redis": "^4.6.13"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/jest": "^29.5.11",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "typescript": "^5.3.3"
  },
  "peerDependencies": {
    "redis": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "redis": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/civet/translation-engine"
  },
  "bugs": {
    "url": "https://github.com/civet/translation-engine/issues"
  }
}
